<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.Group?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Pane?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.shape.Polygon?>

<StackPane xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml"
           fx:controller="com.bananarepublic.controller.MainMenuController"
           styleClass="bg-parchment" prefWidth="1280" prefHeight="800">

    <Pane fx:id="livingLayer" pickOnBounds="false"/>

    <Group fx:id="hexDeco" StackPane.alignment="TOP_RIGHT" mouseTransparent="true">
        <Polygon points="50,10, 100,10, 125,50, 100,90, 50,90, 25,50"
                 fill="transparent" stroke="#2da3c2" strokeWidth="1.4" opacity="0.25"/>
        <Polygon points="125,10, 175,10, 200,50, 175,90, 125,90, 100,50"
                 fill="transparent" stroke="#2da3c2" strokeWidth="1.4" opacity="0.25"/>
        <Polygon points="100,90, 150,90, 175,130, 150,170, 100,170, 75,130"
                 fill="transparent" stroke="#2da3c2" strokeWidth="1.4" opacity="0.25"/>
    </Group>

    <VBox styleClass="card" alignment="CENTER" maxWidth="460" maxHeight="-Infinity"
          spacing="0">
        <padding><Insets top="44" right="48" bottom="38" left="48"/></padding>

        <Label styleClass="eyebrow" text="STRATEGY · 3–4 PLAYERS · LOCAL"/>

        <Label styleClass="wordmark, wordmark-l" text="BANANA" alignment="CENTER">
            <VBox.margin><Insets top="8" bottom="-6"/></VBox.margin>
        </Label>
        <Label styleClass="wordmark, wordmark-l" text="REPUBLIC" alignment="CENTER"/>

        <Region styleClass="wordmark-underline" maxWidth="200" prefHeight="3">
            <VBox.margin><Insets top="10" bottom="30"/></VBox.margin>
        </Region>

        <VBox spacing="12" fillWidth="true">
            <Button fx:id="newGameBtn"  styleClass="btn,btn-gold"    text="▶  NEW GAME"
                    onAction="#onNewGame" maxWidth="Infinity"/>
            <Button fx:id="loadGameBtn" styleClass="btn,btn-outline" text="⤓  LOAD GAME"
                    onAction="#onLoadGame" maxWidth="Infinity"/>
            <Button fx:id="exitBtn"     styleClass="btn,btn-outline" text="✕  EXIT"
                    onAction="#onExit" maxWidth="Infinity"/>
        </VBox>

        <Label styleClass="text-mute" text="v0.4.0 — IF2210 Tubes 2 · Java 21 + JavaFX 21">
            <VBox.margin><Insets top="26"/></VBox.margin>
        </Label>
    </VBox>
</StackPane>
