<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<StackPane fx:id="root" xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml"
           fx:controller="com.bananarepublic.controller.StealDialogController"
           styleClass="modal-backdrop" prefWidth="1280" prefHeight="800">

    <VBox styleClass="modal" maxWidth="620" maxHeight="-Infinity">

        <HBox styleClass="modal__header" alignment="CENTER_LEFT">
            <Label styleClass="modal__title" text="🥷  RESOURCE THEFT"
                   HBox.hgrow="ALWAYS" maxWidth="Infinity"/>
            <Button styleClass="modal__close" text="✕" onAction="#onClose"/>
        </HBox>

        <VBox styleClass="modal__body" spacing="12">
            <Label text="Select one player bordering the Nimon Ungu's new location."
                   wrapText="true"
                   style="-fx-font-size: 13px; -fx-text-fill: -ink-mute;"/>
            <HBox fx:id="targetRow" spacing="12"/>
        </VBox>

        <HBox styleClass="modal__footer">
            <Button styleClass="btn,btn-outline" text="CANCEL" onAction="#onClose"/>
            <Button styleClass="btn,btn-gold"    text="CONFIRM STEAL" onAction="#onConfirm"/>
        </HBox>
    </VBox>
</StackPane>
