<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<StackPane fx:id="root" xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml"
           fx:controller="com.bananarepublic.controller.ScoreboardDialogController"
           styleClass="modal-backdrop" prefWidth="1280" prefHeight="800">

    <VBox styleClass="modal" maxWidth="560" maxHeight="-Infinity">
        <HBox styleClass="modal__header" alignment="CENTER_LEFT">
            <Label styleClass="modal__title" text="📊  SCOREBOARD"
                   HBox.hgrow="ALWAYS" maxWidth="Infinity"/>
            <Button styleClass="modal__close" text="✕" onAction="#onClose"/>
        </HBox>

        <VBox styleClass="modal__body" spacing="10">
            <Label fx:id="summaryBand" styleClass="warn-band" maxWidth="Infinity"
                   text="Peringkat pemain akan muncul di sini."/>
            <ScrollPane fitToWidth="true" hbarPolicy="NEVER" vbarPolicy="AS_NEEDED" prefViewportHeight="420">
                <content>
                    <VBox fx:id="rowsBox" spacing="8"/>
                </content>
            </ScrollPane>
        </VBox>

        <HBox styleClass="modal__footer">
            <Region HBox.hgrow="ALWAYS"/>
            <Button styleClass="btn,btn-gold" text="TUTUP" onAction="#onClose"/>
        </HBox>
    </VBox>
</StackPane>
