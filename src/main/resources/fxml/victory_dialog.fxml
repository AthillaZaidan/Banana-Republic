<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.RowConstraints?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<StackPane fx:id="root" xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml"
           fx:controller="com.bananarepublic.controller.VictoryDialogController"
           styleClass="modal-backdrop" prefWidth="1280" prefHeight="800">

    <VBox styleClass="modal" maxWidth="720" maxHeight="-Infinity">

        <HBox styleClass="modal__header" alignment="CENTER_LEFT">
            <Label styleClass="modal__title" text="DECLARE VICTORY?"
                   HBox.hgrow="ALWAYS" maxWidth="Infinity"/>
            <Button styleClass="modal__close" text="✕" onAction="#onClose"/>
        </HBox>

        <VBox styleClass="modal__body" spacing="14">
            <Label text="You have reached 10 Victory Points. Reveal your hidden VP cards to confirm the win."
                   wrapText="true"
                   style="-fx-font-size: 13px; -fx-text-fill: -ink-mute;"/>

            <GridPane hgap="12">
                <columnConstraints>
                    <ColumnConstraints percentWidth="50"/>
                    <ColumnConstraints percentWidth="50"/>
                </columnConstraints>
                <rowConstraints><RowConstraints/></rowConstraints>

                <VBox GridPane.columnIndex="0" spacing="4"
                      style="-fx-background-color: rgba(255,255,255,0.7);
                             -fx-border-color: -parchment-line; -fx-background-radius: 10;
                             -fx-border-radius: 10; -fx-padding: 14 18;">
                    <Label styleClass="eyebrow" text="PUBLIC POINTS"/>
                    <Label fx:id="publicPointsValue" text="8"
                           style="-fx-font-family: Georgia; -fx-font-weight: 900;
                                  -fx-font-size: 38px; -fx-text-fill: -ink-1;"/>
                    <Label fx:id="publicPointsBreakdown" text="3 Posts · 1 Lab · 1 Bonus · 1 Bonus"
                           style="-fx-font-size: 11px; -fx-text-fill: -ink-mute;"/>
                </VBox>

                <VBox GridPane.columnIndex="1" spacing="4"
                      style="-fx-background-color: rgba(245, 183, 56, 0.22);
                             -fx-border-color: rgba(245, 183, 56, 0.6); -fx-background-radius: 10;
                             -fx-border-radius: 10; -fx-padding: 14 18;">
                    <Label styleClass="eyebrow,text-gold-deep" text="SECRET CARD POINTS"/>
                    <Label fx:id="secretPointsValue" text="+2"
                           style="-fx-font-family: Georgia; -fx-font-weight: 900;
                                  -fx-font-size: 38px; -fx-text-fill: -gold-deep;"/>
                    <Label fx:id="secretPointsBreakdown" text="2 Poin Rahasia cards in hand"
                           style="-fx-font-size: 11px; -fx-text-fill: -gold-deep;"/>
                </VBox>
            </GridPane>

            <Label styleClass="eyebrow" text="REVEAL SECRET CARDS"/>
            <VBox fx:id="secretList" spacing="6"/>
        </VBox>

        <HBox styleClass="modal__footer">
            <Button styleClass="btn,btn-outline" text="CANCEL" onAction="#onClose"/>
            <Button styleClass="btn,btn-gold"    text="✓ REVEAL SECRETS &amp; WIN GAME"
                    onAction="#onConfirm"/>
        </HBox>
    </VBox>
</StackPane>
