<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.FlowPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Pane?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<StackPane xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml"
           fx:controller="com.bananarepublic.controller.TurnTransitionController"
           styleClass="bg-slate" prefWidth="1280" prefHeight="800">

    <Pane fx:id="livingLayer" pickOnBounds="false"/>

    <VBox alignment="CENTER" spacing="18" maxWidth="620">
        <Label styleClass="eyebrow,eyebrow-on-dark" text="TURN TRANSITION"/>
        <Label styleClass="wordmark" text="BANANA REPUBLIC" style="-fx-font-size: 38px;"/>
        <Region styleClass="wordmark-underline" maxWidth="220" prefHeight="3"/>

        <VBox alignment="TOP_LEFT" spacing="18" styleClass="card-dark,turn-transition-card">
            <HBox alignment="CENTER_LEFT" spacing="16">
                <StackPane fx:id="playerSeal" styleClass="initial-chip,turn-transition-seal" minWidth="78" minHeight="78" maxWidth="78" maxHeight="78">
                    <Label fx:id="playerInitialLabel" text="G" styleClass="turn-transition-seal__initial"/>
                </StackPane>

                <VBox spacing="6">
                    <Label text="NEXT PLAYER" styleClass="eyebrow,eyebrow-on-dark"/>
                    <Label fx:id="nextPlayerLabel" text="Gro" styleClass="turn-transition-title"/>
                    <Label fx:id="playerMetaLabel" text="Blue Team" styleClass="turn-transition-subtitle"/>
                </VBox>

                <Region HBox.hgrow="ALWAYS"/>

                <Label text="PASS DEVICE" styleClass="plaque">
                    <HBox.margin><Insets top="6"/></HBox.margin>
                </Label>
            </HBox>

            <Label fx:id="phaseHintLabel"
                   text="Awali giliran dengan melempar dadu, lalu lanjutkan fase Trade/Build."
                   wrapText="true"
                   styleClass="turn-transition-guidance"/>

            <HBox alignment="CENTER" spacing="12">
                <VBox alignment="CENTER" spacing="6" styleClass="turn-transition-stat">
                    <Label fx:id="publicVpLabel" text="0" styleClass="turn-transition-stat__value"/>
                    <Label text="PUBLIC VP" styleClass="turn-transition-stat__label"/>
                </VBox>
                <VBox alignment="CENTER" spacing="6" styleClass="turn-transition-stat">
                    <Label fx:id="pipesLabel" text="0/15" styleClass="turn-transition-stat__value"/>
                    <Label text="PIPES" styleClass="turn-transition-stat__label"/>
                </VBox>
                <VBox alignment="CENTER" spacing="6" styleClass="turn-transition-stat">
                    <Label fx:id="postsLabel" text="0" styleClass="turn-transition-stat__value"/>
                    <Label text="POSTS" styleClass="turn-transition-stat__label"/>
                </VBox>
                <VBox alignment="CENTER" spacing="6" styleClass="turn-transition-stat">
                    <Label fx:id="labsLabel" text="0" styleClass="turn-transition-stat__value"/>
                    <Label text="LABS" styleClass="turn-transition-stat__label"/>
                </VBox>
                <VBox alignment="CENTER" spacing="6" styleClass="turn-transition-stat">
                    <Label fx:id="cardsLabel" text="0" styleClass="turn-transition-stat__value"/>
                    <Label text="HAND CARDS" styleClass="turn-transition-stat__label"/>
                </VBox>
            </HBox>

            <FlowPane fx:id="badgeRow" hgap="8" vgap="8" prefWrapLength="520"/>
        </VBox>

        <Button fx:id="readyBtn" styleClass="btn,btn-gold,btn-pill"
                text="START TURN"
                minWidth="300" onAction="#onReady"/>

        <Label text="Pastikan perangkat sudah diberikan ke pemain berikutnya sebelum melanjutkan."
               styleClass="turn-transition-note"
               wrapText="true"/>
    </VBox>
</StackPane>
