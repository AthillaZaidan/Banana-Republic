<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.CheckBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.RowConstraints?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<StackPane fx:id="root" xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml"
           fx:controller="com.bananarepublic.controller.SettingsDialogController"
           styleClass="modal-backdrop" prefWidth="1280" prefHeight="800">

    <VBox styleClass="modal" maxWidth="580" maxHeight="-Infinity">

        <HBox styleClass="modal__header" alignment="CENTER_LEFT">
            <Label styleClass="modal__title" text="⚙  SETTINGS &amp; PLUGINS"
                   HBox.hgrow="ALWAYS" maxWidth="Infinity"/>
            <Button styleClass="modal__close" text="✕" onAction="#onClose"/>
        </HBox>

        <VBox styleClass="modal__body" spacing="14">
            <GridPane hgap="14">
                <columnConstraints>
                    <ColumnConstraints percentWidth="50"/>
                    <ColumnConstraints percentWidth="50"/>
                </columnConstraints>
                <rowConstraints><RowConstraints/></rowConstraints>

                <VBox styleClass="settings-tile" GridPane.columnIndex="0">
                    <StackPane styleClass="settings-tile-icon,settings-tile-icon-gold">
                        <Label text="💾"/>
                    </StackPane>
                    <Label text="Save Current Game"
                           style="-fx-font-weight: 800; -fx-font-size: 14px;"/>
                    <Label text="Persist the full game state to a .json or .ser file. Can be reloaded from the main menu."
                           wrapText="true"
                           style="-fx-font-size: 12px; -fx-text-fill: -ink-mute;"/>
                    <Region VBox.vgrow="ALWAYS"/>
                    <Button styleClass="btn,btn-outline" text="SAVE STATE"
                            onAction="#onSaveState"
                            style="-fx-padding: 10 14; -fx-font-size: 12px;"/>
                </VBox>

                <VBox styleClass="settings-tile" GridPane.columnIndex="1">
                    <StackPane styleClass="settings-tile-icon,settings-tile-icon-blue">
                        <Label text="🔌"/>
                    </StackPane>
                    <Label text="Load Card Plugin (.jar)"
                           style="-fx-font-weight: 800; -fx-font-size: 14px;"/>
                    <Label text="Replace the Experiment Card pool with cards defined by an external plugin."
                           wrapText="true"
                           style="-fx-font-size: 12px; -fx-text-fill: -ink-mute;"/>
                    <Region VBox.vgrow="ALWAYS"/>
                    <Button styleClass="btn,btn-outline" text="BROWSE FILES"
                            onAction="#onBrowsePlugin"
                            style="-fx-padding: 10 14; -fx-font-size: 12px;"/>
                </VBox>
            </GridPane>

            <Label styleClass="warn-band" maxWidth="Infinity"
                   text="⚠  Loading a plugin mid-game resets the deck and discards undrawn cards."/>

            <CheckBox fx:id="animatedBgToggle" text="Animated background (clouds, gull, bobbing ship)"
                      style="-fx-font-size: 12px; -fx-text-fill: -ink-2;"/>
        </VBox>

        <HBox styleClass="modal__footer">
            <Button styleClass="btn,btn-outline" text="CANCEL" onAction="#onClose"/>
            <Button styleClass="btn,btn-gold"    text="APPLY CHANGES" onAction="#onApply"/>
        </HBox>
    </VBox>
</StackPane>
